# --- Database (Netlify DB / Neon). `netlify db init` injects these automatically. ---
NETLIFY_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"          # pooled, runtime
NETLIFY_DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require" # direct, Prisma migrations
# Optional override if you are not on Netlify DB:
# DATABASE_URL=""

# --- Security ---
ENCRYPTION_KEY=""   # 32 random bytes, base64:  openssl rand -base64 32
JWT_SECRET=""       # openssl rand -base64 48
CRON_SECRET=""      # openssl rand -hex 24

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://droplr.fm"      # use http://localhost:8888 for netlify dev

# --- Spotify ---
# BYO model: each org pastes its own Client ID/Secret in /admin/settings/integrations.
# Leave these blank unless you want a platform-wide fallback app (SPOTIFY_PLATFORM_FALLBACK=true).
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="https://droplr.fm/api/spotify/callback"
SPOTIFY_PLATFORM_FALLBACK="false"

# --- Deezer (new app creation closed since June 2026) ---
DEEZER_ENABLED="false"
DEEZER_APP_ID=""
DEEZER_SECRET=""
DEEZER_REDIRECT_URI="https://droplr.fm/api/deezer/callback"

# --- Email (release-day emails) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="presave@droplr.fm"

# Link lookup needs no keys: Apple Music via iTunes Lookup API, Deezer via its public API (UPC/ISRC).

# --- Optional (not required: queue runs in a Netlify background function) ---
UPSTASH_REDIS_URL=""
QSTASH_TOKEN=""

# Stripe billing (optional — checkout returns 503 until set; build and other pages work without them)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices from Stripe → Product catalogue (price_…). Yearly is optional.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_LABEL_MONTHLY_PRICE_ID=
STRIPE_LABEL_YEARLY_PRICE_ID=
# Webhook endpoint: https://droplr.fm/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted

# Account email (password resets, security notices). Falls back to RESEND_FROM_EMAIL.
ACCOUNT_FROM_EMAIL="droplr.fm <accounts@droplr.fm>"

# Platform owner console at /platform (comp plans for any label). Comma-separated login emails.
PLATFORM_ADMIN_EMAILS=

# Pre-launch gate. "true" = anyone can create a label account. Otherwise only SIGNUP_ALLOWLIST emails can.
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=
