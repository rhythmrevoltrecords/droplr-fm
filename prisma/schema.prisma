// droplr.fm — Prisma schema
// Runtime uses the pooled Netlify DB URL; migrations use the unpooled (direct) URL.

generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("NETLIFY_DATABASE_URL")
  directUrl = env("NETLIFY_DATABASE_URL_UNPOOLED")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  customDomain  String?  @unique
  // Custom domain setup: TXT ownership check → droplr attaches the alias in Netlify → HTTPS check passes → links use it.
  customDomainToken      String? // value for the _droplr TXT record; new token whenever the domain changes
  customDomainVerifiedAt DateTime? // TXT record found (ownership proven)
  customDomainAttachedAt DateTime? // added as a domain alias on the droplr Netlify site
  customDomainLiveAt     DateTime? // HTTPS on the domain reaches droplr; public links only use the domain while set
  customDomainCheckedAt  DateTime?
  customDomainError      String? // last problem, shown in settings
  customDomainFailures   Int       @default(0) // consecutive failed checks once live (3 → back to droplr.fm links)
  metaPixelId   String?
  tiktokPixelId String?
  ga4Id         String?
  kind          String   @default("label") // label (runs a roster) | artist (independent artist, own releases)
  plan          String   @default("free") // free | artist | pro | label | enterprise
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId String?
  planUpdatedAt DateTime?
  // Complimentary plan set by the platform owner (/platform). Acts as a floor: Stripe can raise the plan, never drop below it.
  compPlan      String?
  compNote      String?
  compSetAt     DateTime?
  compSetBy     String?
  /// When the comp lapses. Null means no end date. A comp past this grants nothing, even before the sweep downgrades it.
  compUntil     DateTime?
  /// What the account pays once the comp lapses, in the owner's own words (e.g. "A$17/mo, and that price held for 24 months").
  founderPrice  String?
  /// Last day that rate can be claimed. Null means no deadline. The real enforcement is the
  /// Stripe coupon's redeem_by — this is what the account is told, and what /platform lists.
  founderOfferUntil DateTime?
  /// Stripe promotion code that applies the founding rate at checkout, shown on the billing page.
  founderCode   String?
  /// compSetAt value already shown in the "you've been comped" notice, so it appears once per grant.
  compNoticeAt  DateTime?
  /// compUntil value already shown in the "your comp ended" notice.
  compEndedNoticeAt DateTime?
  signupInviteId String? // the owner invite this account signed up with
  signupInvite  SignupInvite? @relation(fields: [signupInviteId], references: [id], onDelete: SetNull)
  // Refer a friend: this account's share code, and who referred it (if anyone).
  referralCode  String?  @unique

  // BYO Spotify app (encrypted with ENCRYPTION_KEY)
  // BYO SoundCloud app (encrypted with ENCRYPTION_KEY), for gate steps that perform a follow,
  // like or repost on the fan's behalf. Self-serve SoundCloud API keys need an Artist Pro
  // subscription on the artist's own SoundCloud account; without one droplr falls back to the
  // platform app, which shares a single rate limit across every account — see lib/soundcloud.ts.
  soundcloudClientIdEncrypted     String?
  soundcloudClientSecretEncrypted String?
  soundcloudAppStatus             String  @default("none") // none | pending | active
  /** The SoundCloud account gates follow. Resolved on connect so a username change can't break a gate. */
  soundcloudUserId                String?
  soundcloudUsername              String?

  spotifyClientIdEncrypted     String?
  spotifyClientSecretEncrypted String?
  spotifyAppStatus             String  @default("none") // none | pending | active
  spotifyPublicButton          Boolean @default(false) // show "Pre-save on Spotify" to everyone (Development Mode apps: 5 allowlisted users), else only on ?spotify=1 links

  // Deezer (gated by DEEZER_ENABLED env + this flag)
  deezerEnabled Boolean @default(false)

  // Release-day email
  emailFromName String?
  emailReplyTo  String?
  releaseEmailHour Int? @default(9) // fan's local hour for the release-day email; null = as soon as it's out for them

  // Label identity + appearance
  previousSlugs   String[] @default([]) // old slugs keep redirecting after a rename
  /// Custom domains this account used before. The Netlify alias is held for DOMAIN_REDIRECT_DAYS after a
  /// change so links already printed, pinned or in a Spotify bio keep redirecting to the current domain.
  previousDomains String[] @default([])
  timezone        String   @default("Australia/Brisbane") // IANA zone: date display + scheduling input
  locationLabel   String   @default("Brisbane") // shown in admin, e.g. "DATE (SYDNEY)"
  themePreference String   @default("dark") // dark | light | system
  themePublic     Boolean  @default(false) // also apply themePreference to public smart links / bio pages
  dashboardGlow   Boolean  @default(true) // soft accent-colour gradient behind the admin / artist dashboards
  accentColor     String? // hex; admin top border + fallback when a release has no extracted colour

  createdAt DateTime  @default(now())
  users     User[]
  releases  Release[]
  invites   Invite[]
  bioPages  BioPage[]
  artists   Artist[]
  feedbackThreads  FeedbackThread[]
  referralsMade    Referral[] @relation("ReferralReferrer")
  referredBy       Referral?  @relation("ReferralReferred")
  newsEmails       NewsEmail[]
  fanContacts      FanContact[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("artist") // owner | admin | artist
  artistName     String?
  termsAcceptedAt DateTime? // when they ticked "I agree" at signup / invite
  termsVersion    String? // LEGAL.version accepted
  sessionsValidFrom DateTime? // sessions issued before this are rejected (password change/reset, "sign out everywhere")
  emailVerifiedAt   DateTime? // clicked the emailed link (or reset their password by email); null = unconfirmed address
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  releases       Release[]    @relation("ArtistReleases")
  artistProfile  Artist? // roster profile this login belongs to (role artist)
  feedbackThreads FeedbackThread[]
  pushSubscriptions PushSubscription[]
  // Which push notifications this login wants: { milestones, releaseLive, feedback, referrals } (missing = on).
  pushPrefs      Json?
  tourDoneAt     DateTime? // finished or skipped the first-login walkthrough
  /** Roster rows on other labels that have been granted read access to this account. */
  linkedRosterRows Artist[] @relation("LinkedRoster")
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  artistName     String?
  role           String       @default("artist")
  /**
   * "signup" = accepting creates a new login in this org (the original behaviour).
   * "link"   = accepting grants an EXISTING droplr account read access to this roster row's
   *            releases. Nothing is created and nothing is merged.
   */
  kind           String       @default("signup")
  // Invite to log in for an existing roster profile. Null = generic invite (accepting creates a profile).
  artistProfileId String?
  artistProfile   Artist?     @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model Release {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artistId       String?
  // Login access. Derived from artistProfile.userId (lib/artists.ts syncReleaseAccess); access checks read this.
  artist         User?        @relation("ArtistReleases", fields: [artistId], references: [id], onDelete: SetNull)
  artistProfileId String?
  artistProfile  Artist?      @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  slug           String       @unique
  title          String
  artistName     String
  coverUrl       String
  accentColor    String?
  spotifyUrl     String?
  spotifyAlbumId String?
  spotifyTrackId String?
  spotifyArtistId String?
  upc            String?
  isrc           String?
  releaseDate    DateTime
  // local: unlocks at the same wall-clock time in every fan's timezone (stores release at midnight per country).
  // global: one instant worldwide. releaseDate is always the label's own moment (its org timezone).
  rollout        String       @default("local")
  linksCheckedAt DateTime? // last store-link scan (pre-release daily, then hourly after release)
  processingUntil DateTime? // lease held by the release-day processor (no two runs on one release)
  status         String       @default("upcoming") // upcoming | live
  isPublic       Boolean      @default(true)
  autoReResolve  Boolean      @default(true)
  resolvedAt     DateTime?
  emailsSentAt   DateTime?
  createdAt      DateTime     @default(now())

  /** Shareable release report: off until the label turns it on, revocable by rotating the token. */
  reportToken    String?   @unique
  reportSharedAt DateTime?

  /**
   * Intent only, captured ahead of the unreleased pool being built. Ticking it shares
   * nothing with anyone: it records that this account would opt this release in when the
   * pool exists, so the pool isn't empty on the day it launches.
   */
  poolOptIn   Boolean   @default(false)
  poolOptInAt DateTime?

  /**
   * "release" = a record going to stores. "download" = a free download behind a gate — an edit
   * or mashup pack, stems for a remix comp, unreleased tracks, a VIP.
   *
   * Deliberately the same record rather than a second object: the public page, tenant routing,
   * QR codes, link variants, insights, fan capture and the press kit all work on a download for
   * free, and "everything generated from one release record" stays true.
   *
   * Anything counting releases against a plan MUST filter kind: "release" — downloads have their
   * own cap (PLAN_LIMITS.downloads).
   */
  kind           String       @default("release") // release | download
  /**
   * Where the file actually lives: the artist's own Drive, Dropbox, host or Bandcamp code page.
   *
   * droplr stores the URL and never the file. Gates are mostly unofficial remixes and edits, and
   * hosting those would make droplr the party a takedown notice lands on rather than a service
   * that points at one — the same posture a smart link already has toward Spotify.
   */
  downloadUrl    String?
  /** "320 MP3 + WAV, 412MB" — sets expectations before someone spends actions on the gate. */
  downloadNote   String?

  gateSteps    GateStep[]
  gateUnlocks  GateUnlock[]
  links        ReleaseLink[]
  linkVariants  LinkVariant[]
  promoDone     PromoTaskDone[]
  promoReminders PromoStepReminder[]
  clickEvents   ClickEvent[]
  pageViews     PageView[]
  preSaves      PreSave[]

  @@index([organizationId])
  @@index([artistId])
  @@index([artistProfileId])
  @@index([releaseDate])
  liveNotifiedAt        DateTime? // push "is live" sent to the team
  presaveMilestoneNotified Int   @default(0) // highest pre-save milestone already pushed
}

// Roster profile. Exists with or without a login; userId links the artist's login when they have one.
model Artist {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  status           String       @default("active") // active | prospect | alumni
  genre            String?
  bio              String?
  email            String? // label only
  phone            String? // label only
  location         String?
  website          String?
  socialLinks      Json? // { instagram, tiktok, spotify, … }: https URLs only
  photoUrl         String?
  pressPhotoUrls   String[]     @default([])
  accentColor      String?
  signedAt         DateTime?
  notes            String? // label only, never shown to the artist
  /**
   * Intent only, captured ahead of bookable profiles. Nothing is published or shown to
   * anyone: it records that this artist would take booking enquiries when that exists.
   */
  bookingsOpen   Boolean   @default(false)
  bookingsOpenAt DateTime?

  spotifyArtistId  String?
  monthlyListeners Int?
  followers        Int?
  statsUpdatedAt   DateTime?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /**
   * A droplr account in ANOTHER organisation that this roster row belongs to — an artist who
   * already had their own account when the label added them.
   *
   * Deliberately separate from userId. userId means "this artist has a login inside this org";
   * linkedUserId means "an existing account elsewhere has been granted read access to the
   * releases this label puts out under their name". Reusing userId would have made a cross-org
   * account look like a member of the label's organisation to every query that reads it.
   *
   * Not @unique: one artist can be on several labels' rosters. The grant is one-way and
   * revocable — it never gives the label anything of the artist's, and never gives the artist
   * anything of the label's beyond their own releases.
   */
  linkedUserId     String?
  linkedUser       User?        @relation("LinkedRoster", fields: [linkedUserId], references: [id], onDelete: SetNull)
  linkedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  releases         Release[]
  invites          Invite[]

  @@index([organizationId])
}

// Every button on a release page. Replaces PlatformLink (migration add_upc_and_release_links).
// visible=false hides it from fans but keeps it in the editor; isCustom rows carry their own title/button/icon.
model ReleaseLink {
  id         String  @id @default(cuid())
  releaseId  String
  release    Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform   String // spotify, appleMusic, beatport, traxsource, bandcamp, juno, audius, youtube, soundcloud, tidal, deezer, custom, …
  url        String
  title      String? // custom label e.g. "Merch & Vinyl", "Dubplate Download"
  buttonText String? // Play, Buy, Open, Tickets, Follow, Download, Locked, Watch, Listen — or anything
  icon       String? // 1–2 character monogram override, e.g. "S", "B", "↗"
  visible    Boolean @default(true)
  position   Int
  isCustom   Boolean @default(false)

  @@index([releaseId, position])
}

model LinkVariant {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  slug         String
  source       String
  utm_campaign String?
  isActive     Boolean  @default(true)
  clicks       Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([releaseId, slug])
}

model PageView {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  variantId    String?
  source       String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  referrer     String?
  country      String?
  timezone     String? // visitor's IANA zone (Netlify geo): activity charts in fan-local time
  deviceType   String?
  anonId       String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([releaseId, createdAt])
}

model ClickEvent {
  id                 String   @id @default(cuid())
  releaseId          String
  release            Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  variantId          String?
  platform           String
  source             String?
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  referrer           String?
  country            String?
  timezone           String? // visitor's IANA zone (Netlify geo)
  deviceType         String?
  ipHash             String?
  anonId             String?
  linkId             String? // ReleaseLink.id — separates duplicate platforms (e.g. three SoundClouds)
  convertedToPreSave Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([releaseId, createdAt])
  @@index([linkId])
}

model PreSave {
  id                    String    @id @default(cuid())
  releaseId             String
  release               Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform              String // email | spotify | deezer
  email                 String?
  emailConsent          Boolean   @default(false)
  consentAt             DateTime? // last time the fan ticked the consent box
  consentVersion        String? // FAN_EMAIL_CONSENT_VERSION shown at that time
  spotifyUserId         String?
  deezerUserId          String?
  refreshTokenEncrypted String?
  // pending | emailed | emailed_and_clicked | completed | failed | unsubscribed
  status                String    @default("pending")
  sourceVariantId       String?
  source                String?
  anonId                String?
  country               String?
  timezone              String? // fan's IANA zone (browser, else Netlify geo); null → label's timezone
  listenOn              String? // platform the fan said they listen on (leads their release-day email)
  newsConsent           Boolean   @default(false) // optional: also wants news and future releases from this artist/label
  newsConsentAt         DateTime?
  attempts              Int       @default(0)
  lastError             String?
  emailSentAt           DateTime?
  clickedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([releaseId, status])
  @@index([releaseId, timezone])
  @@index([email])
}

// Bio link page (/b/{slug}). Uses the same artwork system as releases:
// avatar/cover → sharp accentColor → accent gradient background + glow.
model BioPage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String       @unique
  title          String
  bio            String?
  imageUrl       String
  accentColor    String?
  isPublic       Boolean      @default(true)
  views          Int          @default(0)
  createdAt      DateTime     @default(now())
  links          BioLink[]

  @@index([organizationId])
}

model BioLink {
  id        String  @id @default(cuid())
  bioPageId String
  bioPage   BioPage @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  platform  String
  label      String?
  url        String
  buttonText String?
  icon       String?
  isActive   Boolean @default(true)
  order      Int     @default(0)
  clicks     Int     @default(0)

  @@index([bioPageId])
}

// "Notify me" sign-ups for coming-soon link types
model WaitlistFeature {
  id             String   @id @default(cuid())
  email          String
  featureName    String   @map("feature_name")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([email, featureName])
  @@map("waitlist_features")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the emailed token; the token itself is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Sliding-window rate limiting for login and password reset (one row per attempt).
model AuthThrottle {
  id        String   @id @default(cuid())
  key       String // e.g. "login:email:<sha256>", "reset:ip:<hash>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Domain aliases to remove from the Netlify site (domain changed or cleared). Retried by the domain cron until done.
model DomainDetach {
  id        String   @id @default(cuid())
  domain    String   @unique
  attempts  Int      @default(0)
  lastError String?
  /// Don't release the alias before this. Set when a label changes domain, so the old one keeps redirecting.
  after     DateTime?
  createdAt DateTime @default(now())
}

/// Emailed "confirm your address" links. Only the sha256 of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String // the address the link was sent to; must still be the account's email when clicked
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A ticked step in a release's promo plan (the plan itself is generated from the release date).
model PromoTaskDone {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  key       String
  doneAt    DateTime @default(now())

  @@unique([releaseId, key])
}

/** Feedback conversation between one user and the droplr.fm team (platform console). */
model FeedbackThread {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String       @default("idea") // idea | bug | question | other
  subject        String
  page           String? // path they were on when they opened it
  status         String       @default("open") // open | closed
  unreadByUser   Boolean      @default(false) // the team replied and the user hasn't opened it since
  unreadByTeam   Boolean      @default(true)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  messages       FeedbackMessage[]

  @@index([userId, lastMessageAt])
  @@index([unreadByTeam, lastMessageAt])
}

model FeedbackMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromTeam    Boolean        @default(false)
  authorEmail String // who wrote it (team replies: the platform admin's login)
  body        String
  createdAt   DateTime       @default(now())

  @@index([threadId, createdAt])
}

/**
 * Refer a friend. Created when a referred account signs up. The referrer earns one free month once the referred
 * account has paid for 30+ days (max 3 earned per rolling 12 months). Rewards are applied as a one-invoice
 * percent-off coupon on the referrer's subscription, one at a time; unapplied rewards wait until they subscribe.
 */
model Referral {
  id             String       @id @default(cuid())
  referrerOrgId  String
  referrer       Organization @relation("ReferralReferrer", fields: [referrerOrgId], references: [id], onDelete: Cascade)
  referredOrgId  String       @unique
  referred       Organization @relation("ReferralReferred", fields: [referredOrgId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending | earned | applied | capped | void
  earnedAt       DateTime?
  appliedAt      DateTime?
  stripeCouponId String?
  note           String? // last reason (e.g. why it's void, Stripe error while applying)
  checkedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([referrerOrgId, status])
  @@index([status, checkedAt])
}

/** A browser / installed app that accepted push notifications for one login (Web Push, VAPID). */
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String? // "iPhone", "Android", "Mac · Chrome" (from the user agent, for the device list)
  failures   Int       @default(0)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/**
 * Platform-owner invite to create an account while signups are closed. Either for one email (single use)
 * or an open link with a use limit. Optional free trial of a paid plan (a comp plan with an expiry).
 */
model SignupInvite {
  id             String    @id @default(cuid())
  tokenHash      String    @unique // sha256 of the code in the link
  tokenEncrypted String // so the owner can copy the link again (ENCRYPTION_KEY)
  email          String? // null = open link anyone with it can use
  kind           String? // artist | label | null (they choose)
  maxUses        Int       @default(1)
  uses           Int       @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  note           String?
  createdBy      String
  emailedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  organizations  Organization[]

  @@index([email])
  @@index([createdAt])
}

/**
 * A one-off email from a label/artist to the fans who ticked the optional
 * "news and new music" box. Release-day emails are a different thing entirely:
 * those go to everyone who pre-saved, and cover only that release (Spam Act).
 */
model NewsEmail {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subject     String
  body        String  // plain text as typed; rendered to paragraphs, never raw HTML
  buttonLabel String?
  buttonUrl   String?

  // Audience, mirroring the Fans page filters. Null = everyone opted in.
  filterCountry   String?
  filterListenOn  String?
  filterReleaseId String?

  status       String    @default("draft") // draft | scheduled | sending | sent | cancelled | failed
  scheduledFor DateTime? // null with status "scheduled" means send at the next run
  /// instant = one moment for everyone. local = localHour in each recipient's own timezone, on the day
  /// scheduledFor falls on in the label's timezone. A local send spans up to 26 hours.
  sendMode     String    @default("instant")
  /// The hour, 0-23, in each recipient's own zone. Taken from the scheduled time. Only read when sendMode is "local".
  localHour    Int?
  startedAt    DateTime?
  sentAt       DateTime?
  processingUntil DateTime? // lease, so two worker runs can't send the same batch twice

  recipients Int     @default(0) // snapshot size when sending started
  sent       Int     @default(0)
  failed     Int     @default(0)
  lastError  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries NewsEmailDelivery[]

  @@index([organizationId, createdAt])
  @@index([status, scheduledFor])
}

/**
 * One row per recipient, written before any sending starts. This is what makes a
 * send resumable across worker runs and guarantees nobody is emailed twice.
 */
model NewsEmailDelivery {
  id          String    @id @default(cuid())
  newsEmailId String
  newsEmail   NewsEmail @relation(fields: [newsEmailId], references: [id], onDelete: Cascade)
  email       String
  /**
   * What the unsubscribe token points at. Exactly one is set: preSaveId for a fan droplr
   * captured, fanContactId for one the label imported. Imported contacts have no PreSave row
   * by design, so the old NOT NULL here is what made them unmailable.
   */
  preSaveId    String?
  fanContactId String?
  sentAt      DateTime?
  error       String?
  /// Computed once at snapshot from this recipient's timezone, so the send loop needs no timezone
  /// logic at all — just a timestamp comparison. Null means "as soon as the send runs".
  sendAfter   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([newsEmailId, email])
  @@index([newsEmailId, sentAt])
  @@index([newsEmailId, sendAfter])
}

/**
 * One row per promo step we've already nudged about, so the 15-minute job can run
 * as often as it likes without ever sending the same reminder twice.
 */
model PromoStepReminder {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  key       String
  sentAt    DateTime @default(now())

  @@unique([releaseId, key])
}

/**
 * One action a fan has to take before a download unlocks.
 *
 * `verified` is not stored: what can actually be proven is a property of the platform, not of
 * the row, and lib/downloads.ts is the single place that decides it. Only SoundCloud (droplr
 * performs the follow/like/repost with the fan's own token and gets a success back) and email
 * are provable. Instagram, TikTok, YouTube and Spotify expose no way for any app to check
 * whether a given visitor follows a given account, so those steps open a link and take the
 * fan's word for it — and the builder says so rather than implying a check.
 */
model GateStep {
  id         String   @id @default(cuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  /** email | soundcloud | instagram | tiktok | youtube | spotify | facebook | link */
  platform   String
  /** email | follow | like | repost | visit */
  action     String
  /** Profile or track URL the fan is sent to, or whose owner the action is performed on. */
  target     String?
  /** SoundCloud numeric id resolved from target at save time, so a later rename can't break the gate. */
  targetId   String?
  required   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([releaseId, position])
}

/**
 * One fan's progress through a gate, and their unlock once it's finished.
 *
 * Progress has to live server-side rather than in a cookie because a SoundCloud step bounces the
 * fan off to soundcloud.com and back, and anything they could edit themselves would make a
 * "performed" step a lie. Keyed by the anonymous visitor id the middleware already sets.
 *
 * `completedAt` is what the unlock token is issued against, so a fan who comes back later gets
 * their download without re-gating, and the funnel has a denominator that isn't a page view.
 * Step-level drop-off comes from ClickEvent rows written per attempt (platform "gate:<step>"),
 * which keeps it inside the insights aggregation that already exists.
 */
model GateUnlock {
  id         String   @id @default(cuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  email       String?
  anonId      String
  /** Step platforms actually completed, for "which step loses people". */
  via         String[]
  /** Null while they're part-way through; set when every required step is done. */
  completedAt DateTime?
  country     String?
  timezone    String?
  createdAt   DateTime  @default(now())

  @@unique([releaseId, anonId])
  @@index([releaseId, createdAt])
  @@index([releaseId, email])
}

/**
 * A fan address the label already had — imported from wherever they collected it before droplr
 * (a gate service, a mailing list, their own site), rather than captured by a droplr page.
 *
 * Deliberately NOT a PreSave. PreSave rows are what release-day sending reads, and an imported
 * address has not asked for any particular release. Keeping them in their own table means an
 * import cannot put anyone into a release-day send by accident — the send path can't see this
 * table at all.
 *
 * consentSource / consentAt / consentNote are the provenance the law actually asks for: who
 * consented, when, and how. The importer types it in and attests to it; we store their answer
 * verbatim so that if it's ever questioned there's a record rather than a shrug.
 */
model FanContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  country        String?
  timezone       String?
  /** Where the label collected it: "hypeddit" | "mailchimp" | "own-site" | "other". Free text, trimmed. */
  consentSource  String
  /** When the fan opted in, as stated by the importer. Null when they couldn't say. */
  consentAt      DateTime?
  /** What the fan actually agreed to, in the importer's words. Kept verbatim. */
  consentNote    String?
  /** marketing = ticked a box to receive music news. transactional = only ever gave it for a download. */
  consentKind    String       @default("transactional")
  /** mailable | pending | unsubscribed. transactional imports start pending and must confirm. */
  status         String       @default("pending")
  importId       String
  importedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([importId])
}
