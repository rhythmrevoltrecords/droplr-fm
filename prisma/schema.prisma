// droplr.fm — Prisma schema
// Runtime uses the pooled Netlify DB URL; migrations use the unpooled (direct) URL.

generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("NETLIFY_DATABASE_URL")
  directUrl = env("NETLIFY_DATABASE_URL_UNPOOLED")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  customDomain  String?  @unique
  // Custom domain setup: TXT ownership check → droplr attaches the alias in Netlify → HTTPS check passes → links use it.
  customDomainToken      String? // value for the _droplr TXT record; new token whenever the domain changes
  customDomainVerifiedAt DateTime? // TXT record found (ownership proven)
  customDomainAttachedAt DateTime? // added as a domain alias on the droplr Netlify site
  customDomainLiveAt     DateTime? // HTTPS on the domain reaches droplr; public links only use the domain while set
  customDomainCheckedAt  DateTime?
  customDomainError      String? // last problem, shown in settings
  customDomainFailures   Int       @default(0) // consecutive failed checks once live (3 → back to droplr.fm links)
  /// While DOMAINS_OPEN is off, only accounts marked here may connect a NEW domain. Set from /platform.
  /// Accounts that already had a domain when the gate landed were marked automatically, so nothing existing broke.
  domainsAllowedAt       DateTime?
  domainsAllowedBy       String?
  metaPixelId   String?
  tiktokPixelId String?
  ga4Id         String?
  kind          String   @default("label") // label (runs a roster) | artist (independent artist, own releases)
  plan          String   @default("free") // free | artist | pro | label | enterprise
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId String?
  /// The last Checkout session started for this org. Expired before a new one is created, so only one can ever be paid.
  stripeCheckoutSessionId String?
  planUpdatedAt DateTime?
  // Complimentary plan set by the platform owner (/platform). Acts as a floor: Stripe can raise the plan, never drop below it.
  compPlan      String?
  compNote      String?
  compSetAt     DateTime?
  compSetBy     String?
  /// When the comp lapses. Null means no end date. A comp past this grants nothing, even before the sweep downgrades it.
  compUntil     DateTime?
  /// What the account pays once the comp lapses, in the owner's own words (e.g. "A$17/mo, and that price held for 24 months").
  founderPrice  String?
  /// Last day that rate can be claimed. Null means no deadline. The real enforcement is the
  /// Stripe coupon's redeem_by — this is what the account is told, and what /platform lists.
  founderOfferUntil DateTime?
  /// Stripe promotion code that applies the founding rate at checkout, shown on the billing page.
  founderCode   String?
  /// compSetAt value already shown in the "you've been comped" notice, so it appears once per grant.
  compNoticeAt  DateTime?
  /// compUntil value already shown in the "your comp ended" notice.
  compEndedNoticeAt DateTime?
  signupInviteId String? // the owner invite this account signed up with
  signupInvite  SignupInvite? @relation(fields: [signupInviteId], references: [id], onDelete: SetNull)
  // Refer a friend: this account's share code, and who referred it (if anyone).
  referralCode  String?  @unique

  // BYO Spotify app (encrypted with ENCRYPTION_KEY)
  // BYO SoundCloud app (encrypted with ENCRYPTION_KEY), for gate steps that perform a follow,
  // like or repost on the fan's behalf. Self-serve SoundCloud API keys need an Artist Pro
  // subscription on the artist's own SoundCloud account; without one droplr falls back to the
  // platform app, which shares a single rate limit across every account — see lib/soundcloud.ts.
  soundcloudClientIdEncrypted     String?
  soundcloudClientSecretEncrypted String?
  soundcloudAppStatus             String  @default("none") // none | pending | active
  /** The SoundCloud account gates follow. Resolved on connect so a username change can't break a gate. */
  soundcloudUserId                String?
  soundcloudUsername              String?

  spotifyClientIdEncrypted     String?
  spotifyClientSecretEncrypted String?
  spotifyAppStatus             String  @default("none") // none | pending | active
  spotifyPublicButton          Boolean @default(false) // show "Pre-save on Spotify" to everyone (Development Mode apps: 5 allowlisted users), else only on ?spotify=1 links

  // Deezer (gated by DEEZER_ENABLED env + this flag)
  deezerEnabled Boolean @default(false)

  // Release-day email
  emailFromName String?
  emailReplyTo  String?
  releaseEmailHour Int? @default(9) // fan's local hour for the release-day email; null = as soon as it's out for them

  // Label identity + appearance
  previousSlugs   String[] @default([]) // old slugs keep redirecting after a rename
  /// Custom domains this account used before. The Netlify alias is held for DOMAIN_REDIRECT_DAYS after a
  /// change so links already printed, pinned or in a Spotify bio keep redirecting to the current domain.
  previousDomains String[] @default([])
  timezone        String   @default("Australia/Brisbane") // IANA zone: date display + scheduling input
  locationLabel   String   @default("Brisbane") // shown in admin, e.g. "DATE (SYDNEY)"
  themePreference String   @default("dark") // dark | light | system
  themePublic     Boolean  @default(false) // UNUSED since migration 20261107000000_page_mode: each page sets its own mode. Kept, not dropped, so a rollback still works.
  dashboardGlow   Boolean  @default(true) // soft accent-colour gradient behind the admin / artist dashboards
  /**
   * The glow on PUBLIC pages: the halo behind the artwork or avatar, and the accent wash behind
   * the page. One setting for release pages and bio pages together, because it is one look.
   *
   * publicGlow false removes it everywhere. glowColor null keeps today's behaviour — the colour
   * extracted from the artwork — so nothing changes for an account that never touches this.
   */
  publicGlow      Boolean  @default(true)
  glowColor       String?
  accentColor     String? // hex; admin top border + fallback when a release has no extracted colour

  createdAt DateTime  @default(now())
  users     User[]
  releases  Release[]
  invites   Invite[]
  bioPages  BioPage[]
  artists   Artist[]
  feedbackThreads  FeedbackThread[]
  platformMessages PlatformMessage[]
  espConnections   EspConnection[]
  referralsMade    Referral[] @relation("ReferralReferrer")
  referredBy       Referral?  @relation("ReferralReferred")
  newsEmails       NewsEmail[]
  fanContacts      FanContact[]
  contests         Contest[]
  contestEntries   ContestEntry[]
  consentEvents    ConsentEvent[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("artist") // owner | admin | artist
  artistName     String?
  termsAcceptedAt DateTime? // when they ticked "I agree" at signup / invite
  termsVersion    String? // LEGAL.version accepted
  sessionsValidFrom DateTime? // sessions issued before this are rejected (password change/reset, "sign out everywhere")
  emailVerifiedAt   DateTime? // clicked the emailed link (or reset their password by email); null = unconfirmed address
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  releases       Release[]    @relation("ArtistReleases")
  artistProfile  Artist? // roster profile this login belongs to (role artist)
  feedbackThreads FeedbackThread[]
  pushSubscriptions PushSubscription[]
  messagesSeen    PlatformMessageSeen[]
  // Which push notifications this login wants: { milestones, releaseLive, feedback, referrals } (missing = on).
  pushPrefs      Json?
  tourDoneAt     DateTime? // finished or skipped the first-login walkthrough
  guidesDismissed String[] @default([]) // keys from lib/guides.ts this login has closed; see the migration for why it's an array
  /** Roster rows on other labels that have been granted read access to this account. */
  linkedRosterRows Artist[] @relation("LinkedRoster")
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  artistName     String?
  role           String       @default("artist")
  /**
   * "signup" = accepting creates a new login in this org (the original behaviour).
   * "link"   = accepting grants an EXISTING droplr account read access to this roster row's
   *            releases. Nothing is created and nothing is merged.
   */
  kind           String       @default("signup")
  // Invite to log in for an existing roster profile. Null = generic invite (accepting creates a profile).
  artistProfileId String?
  artistProfile   Artist?     @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model Release {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artistId       String?
  // Login access. Derived from artistProfile.userId (lib/artists.ts syncReleaseAccess); access checks read this.
  artist         User?        @relation("ArtistReleases", fields: [artistId], references: [id], onDelete: SetNull)
  artistProfileId String?
  artistProfile  Artist?      @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  /**
   * "on" = social icons under the artist name on the release page, read from artistProfile's
   * socialLinks every render (lib/bio-socials). NULL = none. New releases start "on"; releases
   * that existed before 3 Nov 2026 stay NULL until their owner ticks it.
   */
  socialIcons     String?
  slug           String       @unique
  title          String
  artistName     String
  coverUrl       String
  accentColor    String?
  /**
   * The page's look, set on the release page's Look tab (paid plans). Same values and meaning as
   * the BioPage columns of the same names; NULL everywhere is droplr's default artwork-led look.
   */
  theme           String?
  font            String?
  backgroundUrl   String?
  backgroundColor String?
  buttonColor     String?
  /** Text colour for the page, the glow behind it, and how the social icon row is drawn. NULL = the theme's own. lib/page-look. */
  glowColor       String?
  textColor       String?
  /** plain (text colour, the default), brand (each network's own colour), outline or solid. */
  iconStyle       String?
  iconColor       String?
  /** The background as uploaded, kept when the shown one (backgroundUrl) is a blurred copy, so the blur can change without stacking. */
  backgroundSourceUrl String?
  /** soft | strong, or NULL for none. Baked into the image at save time, never a live CSS blur (LCP). lib/background-blur. */
  backgroundBlur      String?
  /**
   * dark | light | system for this page's public view, or NULL for dark. Free on every plan (the full
   * look is paid). Replaces the account-wide "apply theme to public smart links" switch.
   */
  pageMode            String?
  /** One line of the artist's own lyric, for the lyric share graphic. Never fetched from anywhere. */
  lyricLine      String?
  spotifyUrl     String?
  spotifyAlbumId String?
  spotifyTrackId String?
  spotifyArtistId String?
  /**
   * A Spotify playlist ID. When set, the Spotify button opens the release's track inside that
   * playlist (?context=spotify:playlist:…), so listening carries on through it. NULL = a plain
   * link. Needs a track to start from; lib/spotify-context.
   */
  spotifyPlaylist String?
  upc            String?
  isrc           String?
  releaseDate    DateTime
  // local: unlocks at the same wall-clock time in every fan's timezone (stores release at midnight per country).
  // global: one instant worldwide. releaseDate is always the label's own moment (its org timezone).
  rollout        String       @default("local")
  linksCheckedAt DateTime? // last store-link scan (pre-release daily, then hourly after release)
  processingUntil DateTime? // lease held by the release-day processor (no two runs on one release)
  status         String       @default("upcoming") // upcoming | live
  isPublic       Boolean      @default(true)
  autoReResolve  Boolean      @default(true)
  resolvedAt     DateTime?
  emailsSentAt   DateTime?
  createdAt      DateTime     @default(now())

  /**
   * Store exclusivity, so droplr can warn when a link it is about to publish breaks it.
   *
   * This is the one thing droplr knows that neither Beatport nor the distributor does: the window
   * AND the list of links scheduled on the same record. `exclusiveRulebook` exists because Beatport,
   * LabelWorx and Symphonic publish three different answers about what counts as a breach — droplr
   * answers under the label's own distributor and cites it, rather than averaging three sources into
   * something true of none of them. See lib/exclusivity.ts.
   *
   * `exclusiveWeeks` null with a store set means lifetime. `exclusiveFrom` is the store's own live
   * date, which for an exclusive is earlier than `releaseDate`.
   */
  exclusiveStore    String?
  exclusiveFrom     DateTime?
  exclusiveWeeks    Int?
  exclusiveRulebook String?

  /**
   * Shareable release report: off until the label turns it on, revocable by turning it off.
   * The link's token is looked up by its sha256 and kept encrypted so the dashboard can show the
   * link again; a copy of the database alone opens no report. `reportToken` is the old plaintext
   * column, emptied by the release-check sweep (lib/report sealLegacyReportTokens) and unused otherwise.
   */
  reportToken          String?   @unique
  reportTokenHash      String?   @unique
  reportTokenEncrypted String?
  reportSharedAt       DateTime?

  /**
   * Intent only, captured ahead of the unreleased pool being built. Ticking it shares
   * nothing with anyone: it records that this account would opt this release in when the
   * pool exists, so the pool isn't empty on the day it launches.
   */
  poolOptIn   Boolean   @default(false)
  poolOptInAt DateTime?

  /**
   * "release" = a record going to stores. "download" = a free download behind a gate — an edit
   * or mashup pack, stems for a remix comp, unreleased tracks, a VIP.
   *
   * Deliberately the same record rather than a second object: the public page, tenant routing,
   * QR codes, link variants, insights, fan capture and the press kit all work on a download for
   * free, and "everything generated from one release record" stays true.
   *
   * Anything counting releases against a plan MUST filter kind: "release" — downloads have their
   * own cap (PLAN_LIMITS.downloads).
   */
  kind           String       @default("release") // release | download
  /**
   * Where the file actually lives: the artist's own Drive, Dropbox, host or Bandcamp code page.
   *
   * droplr stores the URL and never the file. Gates are mostly unofficial remixes and edits, and
   * hosting those would make droplr the party a takedown notice lands on rather than a service
   * that points at one — the same posture a smart link already has toward Spotify.
   */
  downloadUrl    String?
  /** "320 MP3 + WAV, 412MB" — sets expectations before someone spends actions on the gate. */
  downloadNote   String?

  gateSteps    GateStep[]
  gateUnlocks  GateUnlock[]
  links        ReleaseLink[]
  linkVariants  LinkVariant[]
  promoDone     PromoTaskDone[]
  promoReminders PromoStepReminder[]
  clickEvents   ClickEvent[]
  pageViews     PageView[]
  preSaves      PreSave[]
  contest       Contest?

  @@index([organizationId])
  @@index([artistId])
  @@index([artistProfileId])
  @@index([releaseDate])
  liveNotifiedAt        DateTime? // push "is live" sent to the team
  presaveMilestoneNotified Int   @default(0) // highest pre-save milestone already pushed
}

// Roster profile. Exists with or without a login; userId links the artist's login when they have one.
model Artist {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  status           String       @default("active") // active | prospect | alumni
  genre            String?
  bio              String?
  email            String? // label only
  phone            String? // label only
  location         String?
  website          String?
  socialLinks      Json? // { instagram, tiktok, spotify, … }: https URLs only
  photoUrl         String?
  pressPhotoUrls   String[]     @default([])
  accentColor      String?
  signedAt         DateTime?
  notes            String? // label only, never shown to the artist
  /**
   * Intent only, captured ahead of bookable profiles. Nothing is published or shown to
   * anyone: it records that this artist would take booking enquiries when that exists.
   */
  bookingsOpen   Boolean   @default(false)
  bookingsOpenAt DateTime?

  /**
   * May this artist show our name and logo on their own bio page?
   *
   * Default true: signing an artist is public anyway, and attribution is normally what a label
   * wants. It is the LABEL's half of the decision — the artist still chooses whether to display
   * it (BioPage.labelBadge), so neither side publishes the other's name alone. The badge also
   * disappears on its own when `status` stops being "active", because "signed to" is a claim
   * about a relationship and this row is what says whether it is still true.
   */
  labelBadge     Boolean   @default(true)

  spotifyArtistId  String?
  monthlyListeners Int?
  followers        Int?
  statsUpdatedAt   DateTime?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /**
   * A droplr account in ANOTHER organisation that this roster row belongs to — an artist who
   * already had their own account when the label added them.
   *
   * Deliberately separate from userId. userId means "this artist has a login inside this org";
   * linkedUserId means "an existing account elsewhere has been granted read access to the
   * releases this label puts out under their name". Reusing userId would have made a cross-org
   * account look like a member of the label's organisation to every query that reads it.
   *
   * Not @unique: one artist can be on several labels' rosters. The grant is one-way and
   * revocable — it never gives the label anything of the artist's, and never gives the artist
   * anything of the label's beyond their own releases.
   */
  linkedUserId     String?
  linkedUser       User?        @relation("LinkedRoster", fields: [linkedUserId], references: [id], onDelete: SetNull)
  linkedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  releases         Release[]
  invites          Invite[]
  bioPages         BioPage[]

  @@index([organizationId])
}

// Every button on a release page. Replaces PlatformLink (migration add_upc_and_release_links).
// visible=false hides it from fans but keeps it in the editor; isCustom rows carry their own title/button/icon.
model ReleaseLink {
  id         String  @id @default(cuid())
  releaseId  String
  release    Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform   String // spotify, appleMusic, beatport, traxsource, bandcamp, juno, audius, youtube, soundcloud, tidal, deezer, custom, …
  url        String
  title      String? // custom label e.g. "Merch & Vinyl", "Dubplate Download"
  buttonText String? // Play, Buy, Open, Tickets, Follow, Download, Locked, Watch, Listen — or anything
  icon       String? // 1–2 character monogram override, e.g. "S", "B", "↗"
  /** Uploaded square image for a link with no platform mark of its own. Wins over the monogram. */
  iconUrl    String?
  visible    Boolean @default(true)
  position   Int
  isCustom   Boolean @default(false)

  @@index([releaseId, position])
}

model LinkVariant {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  slug         String
  source       String
  utm_campaign String?
  isActive     Boolean  @default(true)
  clicks       Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([releaseId, slug])
}

/**
 * One visit to a public page. The subject is a release OR a bio page, never both and never
 * neither -- a CHECK constraint in the database enforces that rather than trusting call sites.
 *
 * releaseId was NOT NULL until 20 Oct 2026, so a bio page could not write here at all and made
 * do with BioPage.views, a single integer, while every release page got source, country, device
 * and an anonymous visitor id. Widening this was the fix, not a second pair of tables: one
 * definition of a view, one place the country and device resolution lives.
 */
model PageView {
  id           String   @id @default(cuid())
  releaseId    String?
  release      Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /** Set when this view was of a bio page. Exactly one of releaseId / bioPageId is ever set. */
  bioPageId    String?
  bioPage      BioPage? @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  variantId    String?
  source       String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  referrer     String?
  country      String?
  timezone     String? // visitor's IANA zone (Netlify geo): activity charts in fan-local time
  deviceType   String?
  anonId       String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([releaseId, createdAt])
  @@index([bioPageId, createdAt])
}

/** A tap on a button. Same subject rule as PageView, enforced by the same kind of CHECK. */
model ClickEvent {
  id                 String   @id @default(cuid())
  releaseId          String?
  release            Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /** Set when this tap was on a bio page. Exactly one of releaseId / bioPageId is ever set. */
  bioPageId          String?
  bioPage            BioPage? @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  variantId          String?
  platform           String
  source             String?
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  referrer           String?
  country            String?
  timezone           String? // visitor's IANA zone (Netlify geo)
  deviceType         String?
  ipHash             String?
  anonId             String?
  linkId             String? // ReleaseLink.id — separates duplicate platforms (e.g. three SoundClouds)
  /** BioLink.id, when the subject is a bio page. Kept apart from linkId so neither id is read against the wrong table. */
  bioLinkId          String?
  bioLink            BioLink? @relation(fields: [bioLinkId], references: [id], onDelete: SetNull)
  convertedToPreSave Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([releaseId, createdAt])
  @@index([bioPageId, createdAt])
  @@index([linkId])
  @@index([bioLinkId])
}

model PreSave {
  /**
   * When the fan clicked the confirmation email for this account's news (lib/news-confirm).
   * `newsConsent` is the box they ticked; news only goes out, and Mailchimp only receives them,
   * once this is set. Anyone can type anyone's address into a form; only the owner can click.
   */
  newsConfirmedAt DateTime?
  id                    String    @id @default(cuid())
  releaseId             String
  release               Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform              String // email | spotify | deezer
  email                 String?
  emailConsent          Boolean   @default(false)
  consentAt             DateTime? // last time the fan ticked the consent box
  consentVersion        String? // FAN_EMAIL_CONSENT_VERSION shown at that time
  spotifyUserId         String?
  deezerUserId          String?
  refreshTokenEncrypted String?
  // pending | emailed | emailed_and_clicked | completed | failed | unsubscribed
  status                String    @default("pending")
  sourceVariantId       String?
  source                String?
  anonId                String?
  country               String?
  timezone              String? // fan's IANA zone (browser, else Netlify geo); null → label's timezone
  listenOn              String? // platform the fan said they listen on (leads their release-day email)
  newsConsent           Boolean   @default(false) // optional: also wants news and future releases from this artist/label
  newsConsentAt         DateTime?
  attempts              Int       @default(0)
  lastError             String?
  emailSentAt           DateTime?
  clickedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([releaseId, status])
  @@index([releaseId, timezone])
  @@index([email])
}

// Bio link page (/b/{slug}). Uses the same artwork system as releases:
// avatar/cover → sharp accentColor → accent gradient background + glow.
model BioPage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String       @unique
  title          String
  bio            String?
  imageUrl       String
  accentColor    String?
  theme          String?
  font           String?
  /**
   * The roster artist this page is for, when it is an artist's page rather than the label's.
   *
   * Only use: scoping the release block to that artist. A label page leaves it null and shows
   * whatever the label put out most recently. SetNull, because removing someone from the roster
   * must never take their public page down with them.
   */
  artistProfileId String?
  artistProfile   Artist?     @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  /**
   * "on" = show the release block. NULL = don't.
   *
   * Opt-in, not opt-out, and that is the whole point of the column. A default of "show" would
   * have published something the account holder never chose: every existing bio page would start
   * broadcasting a release the moment this deployed, and on a page with no artist set that could
   * be another artist's record entirely. Worse, `Release.isPublic` defaults true, so an upcoming
   * track nobody has announced yet would go from "a URL nobody has" to the top of a public page.
   * New pages are created with "on" because the form shows exactly what will appear first.
   */
  releaseBlock   String?
  /**
   * Whole-page background. Both optional; the image wins when both are set.
   *
   * Never blurred. A full-screen blur was measured as the main LCP cost on these pages and was
   * deliberately removed once already — see ArtworkPageShell. A readability scrim is painted over
   * whatever this is, so no upload can make the links unreadable.
   */
  backgroundUrl   String?
  backgroundColor String?
  /** "on" = the artist chose to show their label's badge. NULL = not shown. Needs the label's own permission too. */
  labelBadge     String?
  /**
   * Colour for the link buttons. NULL keeps each theme's own treatment.
   *
   * What it means depends on the theme, deliberately: a glass theme tints its glass with it, and
   * Poster fills solid with it. Set once, correct in all four, rather than four settings. Poster
   * runs it through posterFill first, so a colour small text cannot sit on is darkened rather
   * than published.
   */
  buttonColor    String?
  /** Text colour for the page, the glow behind it, and how the social icon row is drawn. NULL = the theme's own. lib/page-look. */
  glowColor       String?
  textColor       String?
  /** plain (text colour, the default), brand (each network's own colour), outline or solid. */
  iconStyle       String?
  iconColor       String?
  /** The background as uploaded, kept when the shown one (backgroundUrl) is a blurred copy, so the blur can change without stacking. */
  backgroundSourceUrl String?
  /** soft | strong, or NULL for none. Baked into the image at save time, never a live CSS blur (LCP). lib/background-blur. */
  backgroundBlur      String?
  /**
   * "on" = show the subscribe form. NULL = don't.
   *
   * Opt-in for the same reason releaseBlock is: a default of "show" would put a box asking fans
   * for their email address onto every page that already exists, without the account holder ever
   * deciding to collect them. Collecting an address nobody chose to collect is the one default
   * that cannot be undone after the fact.
   */
  subscribe      String?
  /** Button wording. NULL uses the default from lib/bio-subscribe. */
  subscribeText  String?
  /**
   * Comma-separated section keys. NULL = the default order.
   *
   * Never read directly: lib/bio-sections reconciles it against the code's own list, so a key
   * that no longer exists is dropped and a key added later appears on every page without anyone
   * re-saving. A page pinned to a stale list would quietly lose a block.
   */
  sectionOrder   String?
  isPublic       Boolean      @default(true)
  /**
   * "on" = listed in droplr's public gallery of live pages (droplr.fm/b). NULL = not listed.
   *
   * Opt-in, and never set by anything but the owner ticking the box: it puts their name and picture
   * on droplr's own marketing page. Only counts while isPublic is true -- unticking Public takes the
   * page out of the gallery too, without touching this column. See lib/bio-gallery.
   */
  gallery        String?
  /** When `gallery` was last switched on. The gallery lists newest-first by this. */
  galleryAt      DateTime?
  /**
   * "on" = a row of social icons under the name, read from the artist profile's socialLinks every
   * render (lib/bio-socials). NULL = no row. Nothing is copied onto the page, so changing a handle
   * on the profile changes it here too.
   */
  socialIcons    String?
  /** NULL = merch sits behind one "Merch" button that opens it. "page" = on the page. lib/bio-items merchDisplayOf. */
  merchShow      String?
  /** NULL = tiles, two to a row. "carousel" = one row you swipe. */
  merchLayout    String?
  views          Int          @default(0)
  createdAt      DateTime     @default(now())
  links          BioLink[]
  /** Fans who subscribed on this page. SetNull: deleting a page never deletes its fans. */
  subscribers    FanContact[]
  /** Cascade, unlike subscribers: a view of a page that no longer exists is not a fact about anything. */
  pageViews      PageView[]
  clickEvents    ClickEvent[]

  @@index([organizationId])
  @@index([artistProfileId])
}

model BioLink {
  id        String  @id @default(cuid())
  bioPageId String
  bioPage   BioPage @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  platform  String
  label      String?
  url        String
  buttonText String?
  icon       String?
  /** Uploaded square image for a link with no platform mark of its own. Wins over the monogram. */
  iconUrl    String?
  isActive   Boolean @default(true)
  order      Int     @default(0)
  /**
   * Which block of the page this row belongs to. NULL = the link buttons (every row before
   * 1 Nov 2026). "merch" | "video" = those blocks. See lib/bio-items. Every write path scopes by
   * this, so saving the links can never delete a merch item and the reverse.
   */
  section    String?
  /** Video rows only. "on" = featured: full size on the page, ready to play. NULL = a tile that opens it. */
  highlight  String?
  /** All-time taps, including every tap from before ClickEvent covered bio pages. See lib/bio-stats. */
  clicks     Int     @default(0)
  clickEvents ClickEvent[]

  @@index([bioPageId])
}

// "Notify me" sign-ups for coming-soon link types
model WaitlistFeature {
  id             String   @id @default(cuid())
  email          String
  featureName    String   @map("feature_name")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([email, featureName])
  @@map("waitlist_features")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the emailed token; the token itself is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Sliding-window rate limiting for login and password reset (one row per attempt).
model AuthThrottle {
  id        String   @id @default(cuid())
  key       String // e.g. "login:email:<sha256>", "reset:ip:<hash>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// One logged-out session token (by jti). Checked on every authenticated request; pruned once the token would have expired anyway.
model RevokedSession {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Domain aliases to remove from the Netlify site (domain changed or cleared). Retried by the domain cron until done.
model DomainDetach {
  id        String   @id @default(cuid())
  domain    String   @unique
  attempts  Int      @default(0)
  lastError String?
  /// Don't release the alias before this. Set when a label changes domain, so the old one keeps redirecting.
  after     DateTime?
  createdAt DateTime @default(now())
}

/// Emailed "confirm your address" links. Only the sha256 of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String // the address the link was sent to; must still be the account's email when clicked
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A ticked step in a release's promo plan (the plan itself is generated from the release date).
model PromoTaskDone {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  key       String
  doneAt    DateTime @default(now())

  @@unique([releaseId, key])
}

/** Feedback conversation between one user and the droplr.fm team (platform console). */
model FeedbackThread {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String       @default("idea") // idea | bug | question | other
  subject        String
  page           String? // path they were on when they opened it
  status         String       @default("open") // open | closed
  unreadByUser   Boolean      @default(false) // the team replied and the user hasn't opened it since
  unreadByTeam   Boolean      @default(true)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  messages       FeedbackMessage[]

  @@index([userId, lastMessageAt])
  @@index([unreadByTeam, lastMessageAt])
}

model FeedbackMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromTeam    Boolean        @default(false)
  authorEmail String // who wrote it (team replies: the platform admin's login)
  body        String
  createdAt   DateTime       @default(now())

  @@index([threadId, createdAt])
}

/**
 * Refer a friend. Created when a referred account signs up. The referrer earns one free month once the referred
 * account has paid for 30+ days (max 3 earned per rolling 12 months). Rewards are applied as a one-invoice
 * percent-off coupon on the referrer's subscription, one at a time; unapplied rewards wait until they subscribe.
 */
model Referral {
  id             String       @id @default(cuid())
  referrerOrgId  String
  referrer       Organization @relation("ReferralReferrer", fields: [referrerOrgId], references: [id], onDelete: Cascade)
  referredOrgId  String       @unique
  referred       Organization @relation("ReferralReferred", fields: [referredOrgId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending | earned | applied | capped | void
  earnedAt       DateTime?
  appliedAt      DateTime?
  stripeCouponId String?
  note           String? // last reason (e.g. why it's void, Stripe error while applying)
  checkedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([referrerOrgId, status])
  @@index([status, checkedAt])
}

/** A browser / installed app that accepted push notifications for one login (Web Push, VAPID). */
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String? // "iPhone", "Android", "Mac · Chrome" (from the user agent, for the device list)
  failures   Int       @default(0)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/**
 * Platform-owner invite to create an account while signups are closed. Either for one email (single use)
 * or an open link with a use limit. Optional free trial of a paid plan (a comp plan with an expiry).
 */
model SignupInvite {
  id             String    @id @default(cuid())
  tokenHash      String    @unique // sha256 of the code in the link
  tokenEncrypted String // so the owner can copy the link again (ENCRYPTION_KEY)
  email          String? // null = open link anyone with it can use
  kind           String? // artist | label | null (they choose)
  maxUses        Int       @default(1)
  uses           Int       @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  note           String?
  createdBy      String
  emailedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  organizations  Organization[]

  @@index([email])
  @@index([createdAt])
}

/**
 * A one-off email from a label/artist to the fans who ticked the optional
 * "news and new music" box. Release-day emails are a different thing entirely:
 * those go to everyone who pre-saved, and cover only that release (Spam Act).
 */
model NewsEmail {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subject     String
  body        String  // plain text as typed; rendered to paragraphs, never raw HTML
  buttonLabel String?
  buttonUrl   String?

  // Audience, mirroring the Fans page filters. Null = everyone opted in.
  filterCountry   String?
  filterListenOn  String?
  filterReleaseId String?

  status       String    @default("draft") // draft | scheduled | sending | sent | cancelled | failed
  scheduledFor DateTime? // null with status "scheduled" means send at the next run
  /// instant = one moment for everyone. local = localHour in each recipient's own timezone, on the day
  /// scheduledFor falls on in the label's timezone. A local send spans up to 26 hours.
  sendMode     String    @default("instant")
  /// The hour, 0-23, in each recipient's own zone. Taken from the scheduled time. Only read when sendMode is "local".
  localHour    Int?
  startedAt    DateTime?
  sentAt       DateTime?
  processingUntil DateTime? // lease, so two worker runs can't send the same batch twice

  recipients Int     @default(0) // snapshot size when sending started
  sent       Int     @default(0)
  failed     Int     @default(0)
  lastError  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries NewsEmailDelivery[]

  @@index([organizationId, createdAt])
  @@index([status, scheduledFor])
}

/**
 * One row per recipient, written before any sending starts. This is what makes a
 * send resumable across worker runs and guarantees nobody is emailed twice.
 */
model NewsEmailDelivery {
  id          String    @id @default(cuid())
  newsEmailId String
  newsEmail   NewsEmail @relation(fields: [newsEmailId], references: [id], onDelete: Cascade)
  email       String
  /**
   * What the unsubscribe token points at. Exactly one is set: preSaveId for a fan droplr
   * captured, fanContactId for one the label imported. Imported contacts have no PreSave row
   * by design, so the old NOT NULL here is what made them unmailable.
   */
  preSaveId    String?
  fanContactId String?
  sentAt      DateTime?
  error       String?
  /// Computed once at snapshot from this recipient's timezone, so the send loop needs no timezone
  /// logic at all — just a timestamp comparison. Null means "as soon as the send runs".
  sendAfter   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([newsEmailId, email])
  @@index([newsEmailId, sentAt])
  @@index([newsEmailId, sendAfter])
}

/**
 * One row per promo step we've already nudged about, so the 15-minute job can run
 * as often as it likes without ever sending the same reminder twice.
 */
model PromoStepReminder {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  key       String
  sentAt    DateTime @default(now())

  @@unique([releaseId, key])
}

/**
 * One action a fan has to take before a download unlocks.
 *
 * `verified` is not stored: what can actually be proven is a property of the platform, not of
 * the row, and lib/downloads.ts is the single place that decides it. Only SoundCloud (droplr
 * performs the follow/like/repost with the fan's own token and gets a success back) and email
 * are provable. Instagram, TikTok, YouTube and Spotify expose no way for any app to check
 * whether a given visitor follows a given account, so those steps open a link and take the
 * fan's word for it — and the builder says so rather than implying a check.
 */
model GateStep {
  id         String   @id @default(cuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  /** email | soundcloud | instagram | tiktok | youtube | spotify | facebook | link */
  platform   String
  /** email | follow | like | repost | visit */
  action     String
  /** Profile or track URL the fan is sent to, or whose owner the action is performed on. */
  target     String?
  /** SoundCloud numeric id resolved from target at save time, so a later rename can't break the gate. */
  targetId   String?
  required   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([releaseId, position])
}

/**
 * One fan's progress through a gate, and their unlock once it's finished.
 *
 * Progress has to live server-side rather than in a cookie because a SoundCloud step bounces the
 * fan off to soundcloud.com and back, and anything they could edit themselves would make a
 * "performed" step a lie. Keyed by the anonymous visitor id the middleware already sets.
 *
 * `completedAt` is what the unlock token is issued against, so a fan who comes back later gets
 * their download without re-gating, and the funnel has a denominator that isn't a page view.
 * Step-level drop-off comes from ClickEvent rows written per attempt (platform "gate:<step>"),
 * which keeps it inside the insights aggregation that already exists.
 */
model GateUnlock {
  id         String   @id @default(cuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  email       String?
  anonId      String
  /** Step platforms actually completed, for "which step loses people". */
  via         String[]
  /** Null while they're part-way through; set when every required step is done. */
  completedAt DateTime?
  country     String?
  timezone    String?
  createdAt   DateTime  @default(now())

  @@unique([releaseId, anonId])
  @@index([releaseId, createdAt])
  @@index([releaseId, email])
}

/**
 * A fan address the label already had — imported from wherever they collected it before droplr
 * (a gate service, a mailing list, their own site), rather than captured by a droplr page.
 *
 * Deliberately NOT a PreSave. PreSave rows are what release-day sending reads, and an address
 * here has not asked for any particular release. Keeping them in their own table means an import
 * cannot put anyone into a RELEASE-DAY send by accident: that path reads PreSave only and cannot
 * see this table.
 *
 * It does NOT mean nothing can see this table. The news composer reads it through
 * lib/news.ts importedAudience, gated on `status = 'mailable'` — and an import starts `pending`,
 * so it stays out until someone confirms. An earlier version of this comment claimed the send
 * path could not see this table at all, which was wrong and was believed for a month.
 *
 * Two kinds of row live here now, told apart by consentSource:
 *   - an IMPORT: typed in from wherever the account collected it. importId set, no consentVersion.
 *   - a PAGE CAPTURE ("bio"): the fan typed it into a droplr page themselves. bioPageId and
 *     consentVersion set, importId NULL, and it is mailable from the moment it is created.
 *
 * consentSource / consentAt / consentNote are the provenance the law actually asks for: who
 * consented, when, and how. The importer types it in and attests to it; we store their answer
 * verbatim so that if it's ever questioned there's a record rather than a shrug.
 */
model FanContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  country        String?
  timezone       String?
  /** Where the label collected it: "hypeddit" | "mailchimp" | "own-site" | "other". Free text, trimmed. */
  consentSource  String
  /** When the fan opted in, as stated by the importer. Null when they couldn't say. */
  consentAt      DateTime?
  /** What the fan actually agreed to, in the importer's words. Kept verbatim. */
  consentNote    String?
  /** marketing = ticked a box to receive music news. transactional = only ever gave it for a download. */
  consentKind    String       @default("transactional")
  /** What wording droplr showed, when droplr showed it. NULL for an import: the wording was not ours. */
  consentVersion String?
  /** mailable | pending | unsubscribed. transactional imports start pending and must confirm. */
  status         String       @default("pending")
  /**
   * The import batch this row came in with. NULL for a row captured on a droplr page.
   *
   * It was required while every row here was an import. A sentinel would have been cheaper than
   * making it nullable and would also have made importedSummary count a bio-page subscriber as
   * an imported contact, which is the one thing the fans screen must not say.
   */
  importId       String?
  importedBy     String?
  /** The bio page whose form captured this address, when one did. */
  bioPageId      String?
  bioPage        BioPage?     @relation(fields: [bioPageId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([importId])
  @@index([bioPageId])
  @@index([organizationId, consentSource, status])
}

/**
 * A remix contest attached to a release — usually a `kind: "download"` stems pack, since the gate
 * that hands the stems out and the contest that takes remixes back are two halves of one thing.
 *
 * droplr stores links, never audio. Australia has no copyright safe harbour for commercial content
 * hosts: the 2018 amendments covered carriage service providers, libraries, archives, educational
 * institutions and disability organisations, and left hosts out deliberately. A US platform hosting
 * entries sits behind DMCA §512(c); droplr would have no equivalent. So there is no file column
 * here and there should never be one without a lawyer's sign-off — see lib/contest.ts.
 *
 * `closesAt` is the label's own instant, like Release.releaseDate: a deadline that quietly means UTC
 * is how a Brisbane label closes entries at 10am local.
 */
model Contest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  releaseId      String       @unique
  release        Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  /** Shown above the form. The prize, the rules, who's judging — the label's words. */
  headline       String
  brief          String?
  prize          String?
  /** Off until the label publishes. A draft contest renders nothing on the public page. */
  published      Boolean      @default(false)
  /** Null means "open as soon as it's published". */
  opensAt        DateTime?
  closesAt       DateTime
  /** Set when the label announces. Until then a closed contest says "judging", not just "closed". */
  winnerAnnouncedAt DateTime?
  /** How many live entries one email may hold. 1 means a new link replaces the old one. */
  maxPerEntrant  Int          @default(1)
  /** Told to entrants on the form, so nobody finds out after they've entered. */
  rulesUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entries        ContestEntry[]
  votes          ContestVote[]

  @@index([organizationId])
  @@index([closesAt])
}

/**
 * One remix, as a link plus the record of who submitted it and what they agreed to.
 *
 * `declarationText` and `declarationVersion` are stored verbatim rather than referenced, because the
 * whole value of the declaration is being able to say later exactly what this person ticked on the
 * day. A foreign key to the current wording would rewrite history the next time the text improves.
 *
 * `linkNormalised` is the deduplication key — host lower-cased, tracking parameters stripped, no
 * trailing slash — so the same SoundCloud link shared from the app and from the website is one entry.
 * `link` keeps exactly what was pasted, because that is what the entrant will say they sent.
 */
model ContestEntry {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contestId      String
  contest        Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  email          String
  artistName     String
  /** Exactly what they pasted. */
  link           String
  /** Deduplication key. Unique per contest. */
  linkNormalised String
  /** Recognised host key from lib/contest.ts ("soundcloud", "drive", …) or null for somewhere new. */
  linkHost       String?
  note           String?

  declarationVersion Int
  declarationText    String
  declarationAt      DateTime @default(now())
  /** Hashed, never raw — the same rule the throttle keys follow. */
  ipHash         String?
  country        String?

  /** unchecked | ok | gone | blocked — from a HEAD request at submit and again when entries close. */
  linkCheck      String   @default("unchecked")
  linkCheckedAt  DateTime?
  /** new | shortlisted | winner | rejected */
  status         String   @default("new")
  /** The label's own notes while judging. Never shown to the entrant. */
  labelNote      String?
  /** The entrant pulled it. Keeps the row, so its link stays reserved and the count stays honest. */
  withdrawnAt    DateTime?
  /**
   * sha256 of the token in the entrant's withdraw link. The token itself is only ever in that email.
   * Nullable only until the release that drops `withdrawToken`: rows written by the old code during
   * a deploy have the plaintext and no hash until the release check hashes them.
   */
  withdrawTokenHash String?  @unique
  /** Old plaintext token. Emptied by hashLegacyWithdrawTokens; never read or written otherwise. Drop next release. */
  withdrawToken     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  votes          ContestVote[]

  @@unique([contestId, linkNormalised])
  @@index([contestId, status])
  @@index([contestId, createdAt])
  @@index([organizationId])
  @@index([contestId, email])
}

/**
 * One public vote for one entry.
 *
 * Unique on (contestId, anonId): a visitor picks ONE favourite per contest and can move it, rather
 * than hearting everything. A heart per entry rewards whoever gets the most people to tap the most
 * buttons; one movable pick is the closest a public vote comes to meaning "this is the best one", and
 * it makes the numbers legible — they add up to the number of people who voted.
 *
 * `ipHash` exists so the label can see how few networks a count came from before treating it as a
 * verdict (lib/contest.ts voteConcentration). It is hashed, never raw, like every other address in
 * this schema.
 *
 * Votes are advisory. Nothing in the code picks a winner from them; a label does, in /admin.
 */
model ContestVote {
  id        String       @id @default(cuid())
  contestId String
  contest   Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entryId   String
  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /** The anonymous visitor id the middleware already sets. No account, no email. */
  anonId    String
  ipHash    String?
  country   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([contestId, anonId])
  @@index([entryId])
}

/**
 * A notice from droplr.fm shown inside the dashboard: either to one account, or to everyone.
 *
 * The Terms already name "a notice in the dashboard" as how we give notice (twice — under
 * Availability and changes, and under Changes to these terms), so this makes an existing promise
 * real rather than inventing an obligation. Treat anything sent through it as notice actually
 * given.
 *
 * `organizationId` null means everyone. There is deliberately no "all artists" or "all labels"
 * audience: two states are easy to reason about and easy to test, three invite a mistake where a
 * message reaches people it wasn't written for.
 */
model PlatformMessage {
  id             String        @id @default(cuid())
  title          String?
  body           String
  /** Optional single link. Stored apart from the body so nothing has to parse or render markup. */
  linkUrl        String?
  linkLabel      String?
  tone           String        @default("info") // info | good | warn
  /** null = every account. Otherwise only this one. */
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startsAt       DateTime      @default(now())
  endsAt         DateTime?
  /** Pulled early. Kept rather than deleted so "what did we tell people, and when" survives. */
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  seen           PlatformMessageSeen[]

  @@index([organizationId])
  @@index([createdAt])
}

/**
 * One row per login per message dismissed.
 *
 * A row rather than a flag on the message, because "everyone has seen it" is not a property of the
 * message — each person dismisses their own copy. And a row rather than an array on User (which is
 * what the guide cards use) because messages are unbounded over time while guides are six.
 */
model PlatformMessageSeen {
  messageId String
  message   PlatformMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt    DateTime        @default(now())

  @@id([messageId, userId])
  @@index([userId])
}

/// A label's connection to its own email service provider (Mailchimp first). droplr pushes the
/// fans it has collected — pre-savers who ticked "news", and imported contacts marked mailable —
/// into the label's existing audience. Credentials are AES-256-GCM encrypted (lib/crypto), never
/// returned to the browser. One connection per provider per org.
model EspConnection {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        String // "mailchimp"
  apiKeyEncrypted String
  listId          String? // chosen audience / list id
  listName        String?
  /// Belt-and-braces: only push marketing-consent fans. droplr's audience is already marketing-only,
  /// so this stays true; kept as a guard so a future transactional source can't leak into an ESP.
  marketingOnly   Boolean   @default(true)
  tagPrefix       String? // tag written on each member, e.g. "droplr"
  status          String    @default("active") // active | error | disconnected
  lastError       String?
  lastSyncedAt    DateTime?
  lastSyncedCount Int       @default(0)
  /// Background-job claim, same mechanism as NewsEmail.processingUntil.
  processingUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// An append-only record of a fan opting out of, or back in to, an account's emails. PreSave and
// FanContact hold the current state; this holds when it changed, which the data processing terms
// say droplr keeps. Never updated, only inserted; deleted with the account.
model ConsentEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String // lower-cased
  kind           String // unsubscribe | restore
  via            String // link | one-click | esp
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}
