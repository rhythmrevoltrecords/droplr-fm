{
  "name": "droplr-fm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:security": "tsx --env-file-if-exists=.env scripts/test-security.ts",
    "test:timing": "tsx --env-file-if-exists=.env scripts/test-release-timing.ts",
    "postinstall": "prisma generate",
    "test:news": "tsx --env-file-if-exists=.env scripts/test-news.ts",
    "test:tools": "tsx --env-file-if-exists=.env scripts/test-release-tools.ts",
    "test:import": "tsx --env-file-if-exists=.env scripts/test-fan-import.ts",
    "test:domains": "tsx --env-file-if-exists=.env scripts/test-domains.ts",
    "test:clip": "tsx --env-file-if-exists=.env scripts/test-clip.ts",
    "test:metadata": "tsx --env-file-if-exists=.env scripts/test-metadata.ts",
    "test:contest": "tsx --env-file-if-exists=.env scripts/test-contest.ts",
    "test:gate": "tsx --env-file-if-exists=.env scripts/test-gate.ts",
    "test:comp": "tsx --env-file-if-exists=.env scripts/test-comp.ts",
    "test:seo": "tsx --env-file-if-exists=.env scripts/test-seo.ts",
    "test:roster": "tsx --env-file-if-exists=.env scripts/test-roster-link.ts",
    "test:exclusivity": "tsx --env-file-if-exists=.env scripts/test-exclusivity.ts",
    "test:share": "tsx --env-file-if-exists=.env scripts/test-share.ts",
    "test:guides": "tsx --env-file-if-exists=.env scripts/test-guides.ts",
    "test:messages": "tsx --env-file-if-exists=.env scripts/test-platform-messages.ts",
    "test:stripe": "tsx --env-file-if-exists=.env scripts/test-stripe.ts",
    "test:stats": "tsx --env-file-if-exists=.env scripts/test-platform-stats.ts",
    "test:blog": "tsx --env-file-if-exists=.env scripts/test-blog.ts",
    "test:plancopy": "tsx --env-file-if-exists=.env scripts/test-plan-copy.ts",
    "test:close": "tsx --env-file-if-exists=.env scripts/test-close-account.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@netlify/blobs": "11.1.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "^1.7.2",
    "jose": "6.2.12",
    "lucide-react": "1.49.0",
    "mp4-muxer": "5.2.2",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "6.2.3",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.6.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@netlify/plugin-nextjs": "5.16.1",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
